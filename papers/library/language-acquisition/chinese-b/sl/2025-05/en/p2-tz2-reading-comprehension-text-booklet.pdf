   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">GP04GGY</rdf:li>
    </rdf:Alt>
   </dc:title>
   <dc:subject>
    <rdf:Bag>
     <rdf:li>Air pollution</rdf:li>
     <rdf:li>Balloons</rdf:li>
     <rdf:li>Children</rdf:li>
     <rdf:li>Cities</rdf:li>
     <rdf:li>Climate (campaign title)</rdf:li>
     <rdf:li>Girls</rdf:li>
     <rdf:li>Health</rdf:li>
     <rdf:li>Hearts (symbol)</rdf:li>
     <rdf:li>KWCI (GPI)</rdf:li>
     <rdf:li>Office buildings</rdf:li>
     <rdf:li>One person</rdf:li>
     <rdf:li>Outdoors</rdf:li>
     <rdf:li>Skyscrapers</rdf:li>
     <rdf:li>Smog</rdf:li>
     <rdf:li>Urban areas</rdf:li>
    </rdf:Bag>
   </dc:subject>
   <dc:creator>
    <rdf:Seq>
     <rdf:li>Wu Di</rdf:li>
    </rdf:Seq>
   </dc:creator>
   <dc:rights>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Â© Greenpeace / Wu Di</rdf:li>
    </rdf:Alt>
   </dc:rights>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">A staged photo shows a girl wearing breathing tubes attached to a heart shaped balloon. The scene was created to help visualise risks posed by poor air quality. Beijing experienced 2,589 deaths and a loss of US$328 million in 2012 because of PM2.5 pollution. Cities in Chinaâ€™s Yangtze River Delta, Pearl River Delta, and Beijing-Tianjin-Hebei region suffered over 100 hazy days a year with PM2.5 concentration two to four times above World Health Organization guidelines. Particles less than 2.5 micrometers in diameter, PM2.5, are called "fine" particles and can lodge deeply into the lungs.</rdf:li>
    </rdf:Alt>
   </dc:description>
   <photoshop:TextLayers>
    <rdf:Bag>
     <rdf:li
      photoshop:LayerName="Â© Wu Di / Greenpeace"
      photoshop:LayerText="Â© Wu Di / Greenpeace"/>
    </rdf:Bag>
   </photoshop:TextLayers>
